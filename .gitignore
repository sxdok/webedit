# 构建产物与依赖（可由 npm run build / npm install 再生）
node_modules/
dist/
*.tsbuildinfo
.vite/

# 桌面分发版（apps/desktop）：打包产物与本地下载缓存，都可由 npm run dist 再生
apps/desktop/release/
apps/desktop/dist-mcp/
apps/desktop/.npm-cache/
apps/desktop/.electron-cache/
apps/desktop/.electron-builder-cache/
apps/desktop/.install.log
apps/desktop/.dist.log
apps/desktop/.dist-debug.log
apps/desktop/.portable-selftest.json
apps/desktop/.selftest-report.json
apps/desktop/.shot-*.png

# DSH MCP 管理器的项目级配置（含本机绝对路径，不适合共享仓库；要团队共享请改相对命令后再纳入版本库）
.dsh/@wingsky-1/
# meow-memory 插件的记忆库（工作区本地数据，不随仓库走）
.dsh-meow/

# Python 运行时缓存（启动器无需编译，删除后会自动重建）
__pycache__/
*.pyc

# 临时解包/探针产物（2026-09-28：审计中解 DSH 客户端用过，不进仓库）
.tmp-asar/
.asar-probe/
.probe-capabilities.mjs

# 明文密钥不入库（2026-09-28，首次推送 GitHub 前移出跟踪）：
#   · 本地保留该文件，程序照旧优先用它解密；仓库/干净克隆下回落到 config/buildKey.mjs（随安装包分发的那把）
#   · 分发形态仍用 buildKey.mjs；若要轮换密钥：npm run keygen（会重新生成 config.key）
apps/desktop/config/config.key

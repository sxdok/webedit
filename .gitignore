# 构建产物与依赖（可由 npm run build / npm install 再生）
node_modules/
dist/
*.tsbuildinfo
.vite/

# 桌面分发版（apps/desktop）：打包产物与本地下载缓存，都可由 npm run dist 再生
apps/desktop/release/
apps/desktop/dist-mcp/
apps/desktop/.npm-cache/
apps/desktop/.electron-cache/
apps/desktop/.electron-builder-cache/
apps/desktop/.install.log
apps/desktop/.dist.log
apps/desktop/.selftest-report.json

# Python 运行时缓存（启动器无需编译，删除后会自动重建）
__pycache__/
*.pyc

{
  "app": {
    "title": "可视化编辑器"
  },
  "server": {
    "port": 0,
    "host": "127.0.0.1",
    "openBrowser": false
  },
  "mcp": {
    "enabled": true,
    "transport": "http",
    "host": "127.0.0.1",
    "httpPort": 37651,
    "bridgePort": 37650,
    "autoRestart": true,
    "readyTimeoutMs": 20000,
    "allowWrite": false
  },
  "update": {
    "enabled": true,
    "baseUrl": "https://updates.example.com/visual-editor/",
